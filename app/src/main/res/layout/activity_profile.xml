<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <!-- Banner logo -->
            <ImageView
                android:id="@+id/bannerLogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_banner"
                android:layout_margin="16dp" />

            <!-- Foto de perfil -->
            <ImageView
                android:id="@+id/profileImageView"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:src="@drawable/default_profile_image"
                android:scaleType="centerCrop"
                android:background="@drawable/circle_background"
                android:layout_marginTop="8dp" />

            <!-- Nombre -->
            <TextView
                android:id="@+id/userNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hola, Usuario"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:layout_marginTop="8dp" />

            <!-- Spinner de psicólogo (si aplica) -->
            <Spinner
                android:id="@+id/psychologistTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="16dp" />

            <!-- Vista de calendario (solo psicólogos) -->
            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

            <!-- Citas del día para psicólogo -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dayScheduleRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Título citas -->
            <TextView
                android:id="@+id/appointmentsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tus citas"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp" />

            <!-- Lista de citas -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appointmentRequestsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_margin="8dp" />

            <!-- Título historial -->
            <TextView
                android:id="@+id/testHistoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historial de Tests"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp" />

            <!-- Mensaje vacío -->
            <TextView
                android:id="@+id/emptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aún no has realizado ningún test."
                android:textSize="16sp"
                android:textColor="#777"
                android:visibility="gone"
                android:layout_gravity="center"
                android:layout_marginTop="24dp" />

            <!-- Lista historial -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/testHistoryRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_margin="8dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Banner Ad -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />
</FrameLayout>
