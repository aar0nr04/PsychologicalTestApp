<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <include
        layout="@layout/view_global_header"
        android:id="@+id/topBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ScrollView para el contenido principal -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/adView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <!-- Logo -->
            <ImageView
                android:layout_width="300dp"
                android:layout_height="250dp"
                android:src="@drawable/logo4"
                android:scaleType="fitCenter"
                android:contentDescription="@string/logo_desc"
                android:layout_marginTop="25dp" />

            <!-- Mensaje de bienvenida -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/welcome_message"
                android:textAlignment="center"
                android:textSize="20sp"
                android:textColor="#949494"
                android:paddingBottom="10dp"
                android:lineSpacingExtra="4dp" />

            <!-- Botones principales -->
            <Button
                android:id="@+id/profileButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile"
                android:layout_marginBottom="12dp"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:contentDescription="@string/go_to_profile" />

            <Button
                android:id="@+id/settingsButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings"
                android:layout_marginBottom="12dp"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:contentDescription="@string/settings_desc" />

            <Button
                android:id="@+id/loginButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login"
                android:layout_marginBottom="12dp"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:contentDescription="@string/login_desc" />

            <Button
                android:id="@+id/registerButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register"
                android:layout_marginBottom="12dp"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:contentDescription="@string/register_desc" />

            <Button
                android:id="@+id/testsButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/take_test"
                android:layout_marginBottom="12dp"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:contentDescription="@string/take_test_desc" />

            <Button
                android:id="@+id/psychologistDirectoryButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/psychologist_directory"
                android:layout_marginBottom="12dp"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:contentDescription="@string/psychologist_directory_desc" />

            <Button
                android:id="@+id/buttonPremium"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/go_premium"
                android:layout_marginTop="16dp"
                android:textSize="18sp"
                android:textAllCaps="false"
                android:contentDescription="@string/go_premium_desc"
                android:backgroundTint="#E91E63"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </ScrollView>

    <!-- Banner de anuncio fijo abajo -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-3940256099942544/6300978111"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
