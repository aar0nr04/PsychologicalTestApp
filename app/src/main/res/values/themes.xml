<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base para toda la app -->
    <style name="Theme.PsychologicalTestApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Colores principales -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryColor</item>
        <item name="colorOnPrimary">@color/textColor</item>

        <!-- Colores secundarios -->
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="colorSecondaryVariant">@color/secondaryColor</item>
        <item name="colorOnSecondary">@color/textColor</item>

        <!-- Fondo y superficie -->
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="colorSurface">@color/backgroundColor</item>
        <item name="colorOnSurface">@color/textColor</item>

        <!-- Soporte para vectores en API < 24 -->


        <!-- Barra de estado -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>

</resources>
