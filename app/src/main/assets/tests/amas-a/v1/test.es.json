          { "min": 16, "max": 22, "label": "Elevación leve", "advice": "Cierto nivel de excitabilidad y rumiación; funciona con pequeñas inseguridades." },
          { "min": 23, "max": 28, "label": "Clínicamente significativa", "advice": "Temor/ansiedad notables; rumiación; posible rigidez cognitiva." },
