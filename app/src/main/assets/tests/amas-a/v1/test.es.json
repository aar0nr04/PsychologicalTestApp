          { "min": 4, "max": 5, "label": "Elevación leve", "advice": "Demasiada preocupación por apariencia/tareas; usualmente no disfuncional." },
          { "min": 6, "max": 7, "label": "Clínicamente significativa", "advice": "Estrés elevado en tareas cotidianas y preocupaciones sociales." }
        ]
      },
      {
        "id": "M",
        "ranges": [
          { "min": 0, "max": 1, "label": "Baja (cuestionable)", "advice": "Posible exageración o mala comprensión de los ítems." },
          { "min": 2, "max": 3, "label": "Esperada (válido)", "advice": "Perfil típico/adecuado." },
          { "min": 4, "max": 5, "label": "Elevación leve (válido)", "advice": "Rigidez/moralismo; algo de negación o ingenuidad." },
          { "min": 6, "max": 6, "label": "Clínicamente significativa (cuestionable)", "advice": "Posible sesgo de deseabilidad; poca reflexividad." }
        ]
      },
      {
        "id": "T",
        "ranges": [
          { "min": 0,  "max": 8,  "label": "Baja", "advice": "Confiado y centrado; ocasional tendencia narcisista." },
